# VioX AI OS — copilot configuration
# Copy to .env.local. Without a key the copilot answers from the offline demo brain.
ANTHROPIC_API_KEY=
COPILOT_MODEL=

# OpenRouter — required for catalog models with provider "openrouter"
# (GPT-5.6, Gemini 3.6 Flash, Grok 4.5, Kimi K3, Qwen 3.7 Max, Fable via OR).
OPENROUTER_API_KEY=

# DeepSeek — required for catalog models with provider "deepseek"
# (DeepSeek V4 Flash, DeepSeek V4 Pro).
DEEPSEEK_API_KEY=

# Ollama Cloud — required for catalog models with provider "ollama"
# (GPT-OSS 120B, GLM-5.2, MiniMax M3).
OLLAMA_API_KEY=

# Slack team collaboration — mention @BuenaVista OS in a channel or DM it and
# the right AI-team specialist answers with live numbers (full checklist on
# /integrations). Bot token (xoxb-) + signing secret from api.slack.com/apps.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Default channel id for /api/slack/digest posts (overridable with ?channel=).
SLACK_CHANNEL_ID=
# Shared secret gating /api/slack/digest — cron callers pass ?secret=<value>.
VIOX_CRON_SECRET=
