# VioX AI OS — copilot configuration
# Copy to .env.local. Without a key the copilot answers from the offline demo brain.
ANTHROPIC_API_KEY=
COPILOT_MODEL=

# OpenRouter — required for catalog models with provider "openrouter"
# (GPT-5.6, Gemini 3.6 Flash, Grok 4.5, Kimi K3, Qwen 3.7 Max, Fable via OR).
OPENROUTER_API_KEY=

# DeepSeek — required for catalog models with provider "deepseek"
# (DeepSeek V4 Flash, DeepSeek V4 Pro).
DEEPSEEK_API_KEY=

# Ollama Cloud — required for catalog models with provider "ollama"
# (GPT-OSS 120B, GLM-5.2, MiniMax M3).
OLLAMA_API_KEY=
