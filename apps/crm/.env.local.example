# ============================================================
# VioX CRM — environment (copy to .env.local)
# ============================================================

# Copilot (Claude). Required for /api/copilot; without it the
# panel returns a friendly "copilot not configured" error.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override (defaults to claude-sonnet-5).
# COPILOT_MODEL=claude-sonnet-5

# ---- Data source -------------------------------------------
# Leave BOTH unset for DEMO_MODE: getRepository() serves the
# in-memory Buena Vista fixture dataset (demo today = 2026-07-29).
# Setting NEXT_PUBLIC_SUPABASE_URL flips every app to the Supabase
# driver (packages/db/schema.sql is ready to push) — once wired,
# the newsletter form on buena-vista-ny.vercel.app feeds Guests here.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp concierge (Twilio) ---------------------------
# Powers /api/whatsapp/inbound — Anfitrión answering guest
# WhatsApp messages and capturing reservation requests into the
# CRM. TWILIO_AUTH_TOKEN also turns on X-Twilio-Signature
# validation; without it the endpoint runs open in demo mode so
# it can be curl-tested. TWILIO_WHATSAPP_FROM is the approved
# WhatsApp sender, e.g. whatsapp:+16462468761.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1646...

# ---- Concierge email (Resend) ------------------------------
# Powers the guest lifecycle emails (request received, confirmed,
# updated, declined, waitlist, table ready, order updates) and the
# /inbox unified message log. RESEND_WEBHOOK_SECRET (whsec_…)
# turns on Svix signature verification for /api/email/inbound —
# without it the webhook runs open so it can be curl-tested.
RESEND_API_KEY=re_...
EMAIL_FROM="Buena Vista Concierge <concierge@viox.ai>"
EMAIL_REPLY_TO=juan@viox.ai
RESEND_WEBHOOK_SECRET=

# OpenRouter — required for catalog models with provider "openrouter"
# (GPT-5.6, Gemini 3.6 Flash, Grok 4.5, Kimi K3, Qwen 3.7 Max, Fable via OR).
OPENROUTER_API_KEY=

# DeepSeek — required for catalog models with provider "deepseek"
# (DeepSeek V4 Flash, DeepSeek V4 Pro).
DEEPSEEK_API_KEY=

# Ollama Cloud — required for catalog models with provider "ollama"
# (GPT-OSS 120B, GLM-5.2, MiniMax M3).
OLLAMA_API_KEY=
