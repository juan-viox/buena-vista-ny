# ============================================================
# VioX CRM — environment (copy to .env.local)
# ============================================================

# Copilot (Claude). Required for /api/copilot; without it the
# panel returns a friendly "copilot not configured" error.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override (defaults to claude-sonnet-5).
# COPILOT_MODEL=claude-sonnet-5

# ---- Data source -------------------------------------------
# Leave BOTH unset for DEMO_MODE: getRepository() serves the
# in-memory Buena Vista fixture dataset (demo today = 2026-07-29).
# Setting NEXT_PUBLIC_SUPABASE_URL flips every app to the Supabase
# driver (packages/db/schema.sql is ready to push) — once wired,
# the newsletter form on buena-vista-ny.vercel.app feeds Guests here.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — required for catalog models with provider "openrouter"
# (GPT-5.6, Gemini 3.6 Flash, Grok 4.5, Kimi K3, Qwen 3.7 Max, Fable via OR).
OPENROUTER_API_KEY=

# DeepSeek — required for catalog models with provider "deepseek"
# (DeepSeek V4 Flash, DeepSeek V4 Pro).
DEEPSEEK_API_KEY=

# Ollama Cloud — required for catalog models with provider "ollama"
# (GPT-OSS 120B, GLM-5.2, MiniMax M3).
OLLAMA_API_KEY=
